{
	"schemaVersion": 1,
	"id": "ctcl",
	"version": "${version}",
	"name": "Crafting Table Chunk Loader",
	"description": "Turns every vanilla crafting table into a chunk loader. A button on the crafting screen cycles the loaded square: 0, 1, 3, 5, 7, 9 chunks wide.",
	"authors": [
		"wulfic"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.wulfnet.ctcl.CtclMod"
		],
		"client": [
			"net.wulfnet.ctcl.client.CtclClient"
		]
	},
	"mixins": [
		"ctcl.mixins.json",
		{
			"config": "ctcl.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
